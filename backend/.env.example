# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemma 4 model id. Leave blank to auto-pick the largest instruction-tuned
# Gemma 4 model your key can see (GET /api/health shows which one was chosen).
GEMMA_MODEL=

# Gemini model that scans uploaded files (PDFs, images, slides) into text.
# Gemma 4 then does all the reasoning on that text. Leave blank to skip
# scanning and let Gemma read the files directly.
GEMINI_SCAN_MODEL=gemini-2.5-flash

# true = always use canned demo responses (no API calls)
DEMO_MODE=false

# Supabase Postgres. Use the "Transaction pooler" connection string
# (Project Settings > Database > Connection string, port 6543).
# Leave blank to use a local SQLite file during development.
DATABASE_URL=
